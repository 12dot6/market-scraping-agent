# Personal machine-specific settings (permissions, debug commands)
.claude/settings.local.json

# Generated output — produced by /get-ingredients, not part of the template
output/*.md
output/*.csv
output/archive/*.md
output/archive/*.csv

# Playwright MCP temp logs (auto-cleaned on session stop)
.playwright-mcp/

# Node dependencies
node_modules/
frontend/node_modules/

# Environment secrets
.env

# SQLite database (mounted as docker volume)
db/*.db
db/*.db-wal
db/*.db-shm

# Export files
exports/

# Python
__pycache__/
*.pyc
*.pyo
